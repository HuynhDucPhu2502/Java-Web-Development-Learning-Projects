<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>ADMIN PAGE</title>
</head>
<body>

<a th:href="@{/projects}">Quay về</a>
<h1>Project Form Page</h1>

<form th:action="@{/projects}" method="post" th:object="${project}">
    <div th:if="${project.id != null}">
        <input th:field="*{id}" type="hidden">
    </div>


    <div>
        <label>name</label>
        <input th:field="*{name}">
    </div>
    <div>
        <label>description</label>
        <input th:field="*{description}">
    </div>
    <div>
        <label>name</label>
        <input th:field="*{name}">
    </div>
    <div>
        <label>startDate</label>
        <input th:field="*{startDate}" type="date">
    </div>
    <div>
        <label>dueDate</label>
        <input th:field="*{dueDate}" type="date">
    </div>
    <div>
        <label>budget</label>
        <input th:field="*{budget}" type="number">
    </div>
    <button type="submit">Save</button>
</form>


</body>
</html>